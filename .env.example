# Supabase (после создания проекта через MCP: list_projects → 20-символьный ref)
# Опционально: добавить в .cursor/mcp.json → ?project_ref=abcdefghijklmnop
SUPABASE_PROJECT_REF=

# Supabase keys (для приложения, не для MCP — MCP использует OAuth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini (только server-side)
GEMINI_API_KEY=your-gemini-api-key

# App
NEXT_PUBLIC_APP_URL=https://denis.tuttech.net
